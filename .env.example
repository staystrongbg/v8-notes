# database
# POOLED direct Postgres connection string (NOT prisma+postgres://, NOT Accelerate).
# Use the pooler port (commonly 6543) with pgbouncer=true for app runtime.
DATABASE_URL="postgres://c53f9dab880d8e24418e506418bf2b40e60773f94b2193dbf6520c863fbdf26b:sk_hAFuk4QMChBMC1VJsuMai@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Optional: non-pooled/direct URL, used when you need a connection that supports
# session-level state (e.g. Prisma Studio or long migrations). Falls back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# auth
BETTER_AUTH_SECRET="your better auth secret"
BETTER_AUTH_URL="your better auth url"

GITHUB_CLIENT_ID="your github clientId"
GITHUB_CLIENT_SECRET="your github client secret"

GOOGLE_CLIENT_ID="your google clientId"
GOOGLE_CLIENT_SECRET="your google client secret"

# NEXTAUTH_SECRET is no longer used; better-auth (BETTER_AUTH_SECRET) supersedes it

NODE_ENV="environment"

# app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# bundle analyzer (next.config.ts)
ANALYZE="false"

# email (resend)
RESEND_API_KEY="your resend api key"

# nodemailer
NODEMAILER_EMAIL="nodemailer email"
NODEMAILER_PASSWORD="notemailer generated password"